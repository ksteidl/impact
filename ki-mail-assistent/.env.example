# ── Demo-Modus ─────────────────────────────────────────────
# "true" = App läuft mit Beispieldaten (keine Zugangsdaten nötig)
DEMO_MODE=true

# ── Anthropic (KI-Antworten) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Shopify Admin API ──────────────────────────────────────
# Custom App im Shopify-Admin anlegen: Einstellungen → Apps → Apps entwickeln
# Benötigte Scopes: read_orders, read_customers
SHOPIFY_SHOP_DOMAIN=mein-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10

# ── E-Mail-Postfach (IMAP: Empfang / SMTP: Versand) ───────
IMAP_HOST=imap.example.com
IMAP_PORT=993
SMTP_HOST=smtp.example.com
SMTP_PORT=465
MAIL_USER=support@mein-shop.at
MAIL_PASSWORD=app-passwort

# ── Shop-Identität (für die Signatur der KI-Antworten) ────
STORE_NAME=Mein Shop
STORE_SIGNATURE_NAME=Kay
