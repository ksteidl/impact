# Kopieren nach .env und anpassen.

# Geheimer Schlüssel zur Verschlüsselung der API-Schlüssel (mind. 32 Zeichen).
# Erzeugen z. B. mit:  openssl rand -base64 48
# WICHTIG: sicher aufbewahren – ohne ihn sind gespeicherte API-Schlüssel unlesbar.
APP_SECRET=

# Erster Administrator (nur beim allerersten Start verwendet).
# Bleibt ADMIN_PASSWORD leer, wird ein Einmal-Passwort erzeugt und im Log ausgegeben.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Hinter einem Reverse-Proxy (nginx, Caddy, Traefik, IIS) mit HTTPS: 1 setzen,
# damit Cookies als "Secure" markiert und Client-IPs korrekt protokolliert werden.
TRUST_PROXY=1

# Sitzungsdauer in Stunden
SESSION_HOURS=10

# Maximale Länge einer Nachricht inkl. Dateianhängen (Zeichen)
MAX_MESSAGE_CHARS=200000
